<h1>All Runned Workflows</h1>

<table border="1">
  <tr>
    <th>Workflow Name</th>
    <th>Workflow Status</th>
    <th>Show</th>
  </tr>

  <% @workflow_run.each do |workf_run| %>
    <tr>
      <td><%= workf_run.workflow.name %></td>
      <% if workf_run.success? %>
       <td style="background-color:green;"> success </td>
      <% end %>
      <% if workf_run.skipped? %>
       <td style="background-color:yellow;"> skipped </td>
      <% end %>
      <% if workf_run.failed? %>
       <td style="background-color:red;"> failed </td>
      <% end %>
        <td><%= link_to "Show", workflow_run_path(workf_run) %></td>
            <td> <%= button_to "Delete", workflow_run_path(workf_run), method: :delete %></td>

    </tr>
  <% end %>
</table>