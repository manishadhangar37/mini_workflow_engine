<h2> Run this workflow </h2>
<strong>Workflow Name:</strong>
<%= @workflow.name %><br><br/>
<strong> Trigger URL: </strong>
<% url = "/t/#{@workflow.trigger_path}" %>
<%= "/t/#{@workflow.trigger_path}" %>
 <button onclick="navigator.clipboard.writeText('<%= url %>')"> Copy </button>

<%= form_with url:"/t/#{@workflow.trigger_path}", method: :post do |f| %> 
<strong> Input Payload: </strong> <br/>
<%= text_area_tag :input_payload, JSON.pretty_generate(
{type: @workflow.name,success: false,actor_name: "Manisha"}),
rows: 5,
cols: 30%> <br/>
<%= submit_tag "Run Workflow",style: "background-color:green; border: 2px solid green;" %> <br/> <br/>
<% end %>


     
    
  