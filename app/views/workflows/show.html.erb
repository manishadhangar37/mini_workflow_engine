
<strong>Workflow Name:</strong>
    <%= @workflow.name %><br><br/>

    <strong>Enabled:</strong>
    <%= @workflow.enabled %><br> <br/>

    <strong> trigger_path </strong>
    <%= @workflow.trigger_path %>   <br/> <br/>
    
    <%= button_to "RUN","/t/#{@workflow.trigger_path}",method: :post,params: {type: "#{@workflow.name}",success: false} %> <br/> <br/>
    <%= link_to "Edit", edit_workflow_path(@workflow) %> <br/> <br/>
    <%= button_to "Delete",workflows_path(@workflow),method: :delete %> 

