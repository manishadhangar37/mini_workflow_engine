<h1>Create Workflow</h1>

<%= form_with model: @workflow do |f| %>
 
  <%= f.label :name, "Workflow Name:" %>
  <%= f.text_field :name,id: "workflow_name" %>
  <% if @workflow.errors[:name].any? %>
  <%= @workflow.errors.full_messages_for(:name).to_sentence %>
  <% end %>

  <br/> <br/><br/>
  
   <%= f.label :enabled, "Enabled:" %> 
  <%= f.select :enabled, [["True", true], ["False", false]] %>
  <% if @workflow.errors[:enabled].any? %>
  <%= @workflow.errors.full_messages_for(:enabled).to_sentence %>
  <% end %>
  <br/> <br/>
  <%= label_tag :slack_url,"Where to send message: " %>
<%= text_area_tag :slack_url, " https://hooks.slack.com/services/XXX/YYY/ZZZ", style: "height: 20px; width: 800px;",id:"slack_url" %>
 <br/> <br/> <br/>
  <%= f.label :defination_jason, "Workflow JSON:" %><br/>
  <%= f.text_area :defination_jason, value: JSON.pretty_generate(default_defination_json), rows:18, cols:80 , id:"defination_jason" %>
  <% if @workflow.errors[:defination_jason].any? %>
  <%= @workflow.errors.full_messages_for(:defination_jason).to_sentence %>
  <% end %>
 <br/> <br/> <br/>
  <%= f.submit "Create Workflow" %>

<% end %>
 
<script>
const slack_url = document.getElementById("slack_url")
const json_data = document.getElementById("defination_jason")
const workflow_name = document.getElementById("workflow_name")
slack_url.addEventListener("input", function(){
  defination_json = JSON.parse(json_data.value)
 defination_json.steps[2].url = slack_url.value
  json_data.value = JSON.stringify(defination_json,null,2)
})

workflow_name.addEventListener("input",function(){
defination_json = JSON.parse(json_data.value)
defination_json.name = workflow_name.value
defination_json.steps[0].conditions[0].value = workflow_name.value
json_data.value = JSON.stringify(defination_json,null,2)
})

</script>